Subject: [PATCH] Check EngineeringMode backend availability

--- a/smali_classes6/com/samsung/android/service/EngineeringMode/EngineeringModeManager$EngineeringModeNative.smali
+++ b/smali_classes6/com/samsung/android/service/EngineeringMode/EngineeringModeManager$EngineeringModeNative.smali
@@ -546,4 +546,15 @@
     iget-boolean p0, p0, Lcom/samsung/android/service/EngineeringMode/EngineeringModeManager$EngineeringModeNative;->mSupportJNI:Z

+    if-eqz p0, :unica_engmode_support
+
+    # Loading the donor JNI does not provide its AIDL backend on this vendor.
+    const-string p0, "vendor.samsung.hardware.security.engmode.ISehEngmode/default"
+
+    invoke-static {p0}, Landroid/os/ServiceManager;->isDeclared(Ljava/lang/String;)Z
+
+    move-result p0
+
+    :unica_engmode_support
+
     return p0
 .end method
