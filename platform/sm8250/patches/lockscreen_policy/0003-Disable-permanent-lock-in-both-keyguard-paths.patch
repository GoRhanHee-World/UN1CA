+
+    const/4 v1, 0x0
+
+    iput-boolean v1, p0, Lcom/android/keyguard/KeyguardSecUpdateMonitorImpl;->mPermanentLock:Z
+
+    return v0
 .end method
 
 .method public final updateRemoteLockInfo(Lcom/android/internal/widget/RemoteLockInfo;)V
