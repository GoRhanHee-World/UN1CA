-
-    invoke-virtual {p0}, Lcom/android/internal/widget/LockPatternUtils;->getLskfRetryHardeningPolicy()Z
-
-    move-result p0
-
-    if-eqz p0, :cond_0
-
-    const/16 p0, 0xd
-
-    return p0
-
-    :cond_0
