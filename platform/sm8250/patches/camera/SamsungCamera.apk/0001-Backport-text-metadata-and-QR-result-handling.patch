+++ b/smali_classes2/com/samsung/android/camera/core2/node/qrCode/SaivQRCodeNode.smali
@@ -573,9 +573,9 @@
     invoke-virtual {p2, p1}, Lcom/samsung/android/qrengine/QRBarcodeDecoder;->process([B)I

     move-result p1

-    if-lez p1, :cond_1
+    if-ltz p1, :cond_1

     iget-object p1, p0, Lcom/samsung/android/camera/core2/node/qrCode/SaivQRCodeNode;->mBarcodeRecognizer:Lcom/samsung/android/qrengine/QRBarcodeDecoder;

     invoke-virtual {p1}, Lcom/samsung/android/qrengine/QRBarcodeDecoder;->getRecognizedObjectCount()I
diff --git a/smali_classes4/com/samsung/android/qrengine/QRBarcodeDecoder.smali b/smali_classes4/com/samsung/android/qrengine/QRBarcodeDecoder.smali
index b4d4d838..54e550cd 100644
--- a/smali_classes4/com/samsung/android/qrengine/QRBarcodeDecoder.smali
+++ b/smali_classes4/com/samsung/android/qrengine/QRBarcodeDecoder.smali
@@ -3225,8 +3225,39 @@
     .locals 18

     move-object/from16 v0, p0

+    iget-boolean v1, v0, Lcom/samsung/android/qrengine/QRBarcodeDecoder;->mIsEngineInited:Z
+
+    if-eqz v1, :unica_qr_invalid
+
+    iget v1, v0, Lcom/samsung/android/qrengine/QRBarcodeDecoder;->mEngineId:I
+
+    if-ltz v1, :unica_qr_invalid
+
+    iget v1, v0, Lcom/samsung/android/qrengine/QRBarcodeDecoder;->mImageWidth:I
+
+    if-lez v1, :unica_qr_invalid
+
+    iget v1, v0, Lcom/samsung/android/qrengine/QRBarcodeDecoder;->mImageHeight:I
+
+    if-lez v1, :unica_qr_invalid
+
+    iget v1, v0, Lcom/samsung/android/qrengine/QRBarcodeDecoder;->mStrideWidth:I
+
+    if-lez v1, :unica_qr_invalid
+
+    iget v1, v0, Lcom/samsung/android/qrengine/QRBarcodeDecoder;->mStrideHeight:I
+
+    if-gtz v1, :unica_qr_ready
+
+    :unica_qr_invalid
+    const/4 v1, -0x1
+
+    return v1
+
+    :unica_qr_ready
+
     iget-object v1, v0, Lcom/samsung/android/qrengine/QRBarcodeDecoder;->mDetectRoi:[I

     const/4 v2, 0x0

@@ -3349,9 +3380,9 @@
     invoke-static {v1}, Landroid/text/TextUtils;->isEmpty(Ljava/lang/CharSequence;)Z

     move-result v3

-    const/4 v4, -0x1
+    const/4 v4, 0x0

     if-eqz v3, :cond_1

     return v4
