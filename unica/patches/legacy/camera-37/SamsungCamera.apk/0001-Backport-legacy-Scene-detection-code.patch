Subject: [PATCH] Support legacy scene detection through One UI 9 text callback

diff --git a/smali_classes2/com/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder.smali b/smali_classes2/com/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder.smali
--- a/smali_classes2/com/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder.smali
+++ b/smali_classes2/com/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder.smali
@@ -17,6 +17,10 @@
 .end annotation
 
 
+# static fields
+.field public static sceneDetectionEvent:I = -0x1
+
+
 # instance fields
 .field public e:Ljava/lang/Integer;
 
@@ -24,6 +28,25 @@
 # virtual methods
 .method public final F0(Ljava/lang/Long;Ljava/lang/Integer;Lcom/samsung/android/camera/core2/CamDevice;)V
     .locals 6
+
+    if-eqz p2, :unica_legacy_text
+    invoke-virtual {p2}, Ljava/lang/Integer;->intValue()I
+    move-result v0
+    if-nez v0, :unica_text_ready
+    :unica_legacy_text
+    sget v0, Lcom/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder;->sceneDetectionEvent:I
+    const/4 v1, 0x2
+    if-eq v0, v1, :unica_text_detected
+    const/16 v1, 0x27
+    if-eq v0, v1, :unica_text_detected
+    const/4 v0, 0x0
+    goto :unica_text_value
+    :unica_text_detected
+    const/4 v0, 0x1
+    :unica_text_value
+    invoke-static {v0}, Ljava/lang/Integer;->valueOf(I)Ljava/lang/Integer;
+    move-result-object p2
+    :unica_text_ready
 
     new-instance v0, Lcom/samsung/android/camera/core2/callback/forwarder/a;
 
