From: GoRhanHee <gorhanhee@users.noreply.github.com>
Subject: [PATCH] Resolve Adaptive colour tone arrays by framework field name

Numeric resource IDs change between Samsung framework versions. Reference
the framework R fields so every source uses its own calibration arrays.

diff --git a/smali/com/samsung/android/sead/EadFlickerController.smali b/smali/com/samsung/android/sead/EadFlickerController.smali
--- a/smali/com/samsung/android/sead/EadFlickerController.smali
+++ b/smali/com/samsung/android/sead/EadFlickerController.smali
@@ -780,7 +780,7 @@
 
     move-result-object v0
 
-    const v1, 0x1070056
+    sget v1, Lcom/android/internal/R$array;->config_EadLuxHysteresisInput_Brightening_Sub:I
 
     invoke-virtual {v0, v1}, Landroid/content/res/Resources;->getIntArray(I)[I
 
@@ -792,7 +792,7 @@
 
     move-result-object v0
 
-    const v1, 0x107005a
+    sget v1, Lcom/android/internal/R$array;->config_EadLuxHysteresisOutput_Brightening_Sub:I
 
     invoke-virtual {v0, v1}, Landroid/content/res/Resources;->getIntArray(I)[I
 
@@ -804,7 +804,7 @@
 
     move-result-object v0
 
-    const v1, 0x1070058
+    sget v1, Lcom/android/internal/R$array;->config_EadLuxHysteresisInput_Darkening_Sub:I
 
     invoke-virtual {v0, v1}, Landroid/content/res/Resources;->getIntArray(I)[I
 
@@ -816,7 +816,7 @@
 
