Subject: [PATCH] Use build OTA manifest for manual and scheduled checks

--- a/smali/pj.smali
+++ b/smali/pj.smali
@@ -4958,6 +4958,29 @@
 .method public static p(J)Ljava/lang/String;
     .locals 11
 
+    # Both manual and scheduled checks use this encrypted manifest URL key.
+    const-wide v0, 0x5c18d66cd5d38297L
+
+    cmp-long v0, p0, v0
+
+    if-nez v0, :unica_original_string
+
+    const-string v0, "ro.unica.ota_url"
+
+    invoke-static {v0}, Landroid/os/SemSystemProperties;->get(Ljava/lang/String;)Ljava/lang/String;
+
+    move-result-object v0
+
+    invoke-static {v0}, Landroid/text/TextUtils;->isEmpty(Ljava/lang/CharSequence;)Z
+
+    move-result v1
+
+    if-nez v1, :unica_original_string
+
+    return-object v0
+
+    :unica_original_string
+
     sget-object v0, Lpj;->n:[Ljava/lang/String;
 
     if-nez v0, :cond_0
