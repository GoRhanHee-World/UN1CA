From: GoRhanHee <gorhanhee01@gmail.com>
Subject: [PATCH] Honor HMA enable state after boot and preserve same-app launches

diff --git a/smali_classes2/com/android/server/pm/ComputerEngine.smali b/smali_classes2/com/android/server/pm/ComputerEngine.smali
--- a/smali_classes2/com/android/server/pm/ComputerEngine.smali
+++ b/smali_classes2/com/android/server/pm/ComputerEngine.smali
@@ -43,6 +43,17 @@
     goto :goto_0

     :cond_1
+    if-eqz p2, :hma_ce_not_self
+
+    invoke-virtual {p0, p1, p2}, Lcom/android/server/pm/ComputerEngine;->isCallerSameApp(ILjava/lang/String;)Z
+
+    move-result v2
+
+    if-eqz v2, :hma_ce_not_self
+
+    return v1
+
+    :hma_ce_not_self
     const-string v2, "com.android.vending"

     invoke-virtual {v0, v2}, Ljava/lang/String;->contains(Ljava/lang/CharSequence;)Z
@@ -137,12 +148,34 @@
 .end method

 .method public recreateApplicationList(ILandroid/content/Context;ILjava/util/List;)Ljava/util/List;
-    .locals 0
+    .locals 2

     new-instance p3, Ljava/util/ArrayList;

     invoke-direct {p3, p4}, Ljava/util/ArrayList;-><init>(Ljava/util/Collection;)V

+    invoke-static {}, Lcom/android/server/pm/ComputerEngine;->isBootCompleted()Z
+
+    move-result v0
+
+    if-eqz v0, :hma_list_unfiltered
+
+    if-eqz p2, :hma_list_unfiltered
+
+    invoke-virtual {p2}, Landroid/content/Context;->getContentResolver()Landroid/content/ContentResolver;
+
+    move-result-object v0
+
+    const-string v1, "unica_hma"
+
+    const/4 p4, 0x1
+
+    invoke-static {v0, v1, p4}, Landroid/provider/Settings$System;->getInt(Landroid/content/ContentResolver;Ljava/lang/String;I)I
+
+    move-result v0
+
+    if-ne v0, p4, :hma_list_unfiltered
+
     const/4 p4, 0x0

     invoke-virtual {p0, p1, p4}, Lcom/android/server/pm/ComputerEngine;->canHideApp(ILjava/lang/String;)Z
@@ -151,6 +184,7 @@

     if-nez p0, :cond_0

+    :hma_list_unfiltered
     return-object p3

     :cond_0
@@ -168,7 +202,7 @@
 .end method

 .method public recreatePackageList(ILandroid/content/Context;ILandroid/content/pm/ParceledListSlice;)Landroid/content/pm/ParceledListSlice;
-    .locals 0
+    .locals 2

     new-instance p3, Ljava/util/ArrayList;

@@ -178,6 +212,28 @@

     invoke-direct {p3, p4}, Ljava/util/ArrayList;-><init>(Ljava/util/Collection;)V

+    invoke-static {}, Lcom/android/server/pm/ComputerEngine;->isBootCompleted()Z
+
+    move-result v0
+
+    if-eqz v0, :hma_list_unfiltered
+
+    if-eqz p2, :hma_list_unfiltered
+
+    invoke-virtual {p2}, Landroid/content/Context;->getContentResolver()Landroid/content/ContentResolver;
+
+    move-result-object v0
+
+    const-string v1, "unica_hma"
+
+    const/4 p4, 0x1
+
+    invoke-static {v0, v1, p4}, Landroid/provider/Settings$System;->getInt(Landroid/content/ContentResolver;Ljava/lang/String;I)I
+
+    move-result v0
+
+    if-ne v0, p4, :hma_list_unfiltered
+
     const/4 p4, 0x0

     invoke-virtual {p0, p1, p4}, Lcom/android/server/pm/ComputerEngine;->canHideApp(ILjava/lang/String;)Z
@@ -186,6 +242,7 @@

     if-nez p0, :cond_0

+    :hma_list_unfiltered
     new-instance p0, Landroid/content/pm/ParceledListSlice;

     invoke-direct {p0, p3}, Landroid/content/pm/ParceledListSlice;-><init>(Ljava/util/List;)V
diff --git a/smali_classes2/com/android/server/wm/ActivityStarter.smali b/smali_classes2/com/android/server/wm/ActivityStarter.smali
--- a/smali_classes2/com/android/server/wm/ActivityStarter.smali
+++ b/smali_classes2/com/android/server/wm/ActivityStarter.smali
@@ -45,6 +45,19 @@
     return v1

     :cond_3
+    if-eqz p2, :hma_as_not_self
+
+    iget-object v2, p2, Landroid/content/pm/ActivityInfo;->applicationInfo:Landroid/content/pm/ApplicationInfo;
+
+    if-eqz v2, :hma_as_not_self
+
+    iget v2, v2, Landroid/content/pm/ApplicationInfo;->uid:I
+
+    if-ne p1, v2, :hma_as_not_self
+
+    return v1
+
+    :hma_as_not_self
     const-string v2, "com.android.vending"

     invoke-virtual {v0, v2}, Ljava/lang/String;->contains(Ljava/lang/CharSequence;)Z
